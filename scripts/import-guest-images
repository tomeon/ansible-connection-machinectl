#!/usr/bin/env bash

# Imports the guest root filesystems built by build-guest-images (DIR/*.tar.gz)
# as machine images, boots them, and waits until they have finished booting.
# Must be run as root.
#
# Usage: import-guest-images DIR

set -euo pipefail

if (( $# != 1 )); then
    printf 1>&2 -- 'Usage: %s DIR\n' "${BASH_SOURCE[0]##*/}"
    exit 1
fi

scripts_dir="${BASH_SOURCE[0]%/*}"

shopt -s nullglob

tarballs=("${1%/}"/*.tar.gz)

if (( ${#tarballs[@]} == 0 )); then
    printf 1>&2 -- 'No guest images found in %s\n' "$1"
    exit 1
fi

declare -A pids=()

for tarball in "${tarballs[@]}"; do
    name="${tarball##*/}"
    name="${name%.tar.gz}"
    machinectl --quiet import-tar "$tarball" "$name" &
    pids[$name]=$!
done

status=0

for name in "${!pids[@]}"; do
    if ! wait "${pids[$name]}"; then
        printf 1>&2 -- 'Failed to import %s\n' "$name"
        status=1
    fi
done

(( status == 0 )) || exit "$status"

# Work around problems with systemd-nspawn 249 (Ubuntu 22.04); 255 and later
# boot the guests as they are.
systemd_version="$(systemctl --version | awk 'NR == 1 { print $2 }')"

if (( systemd_version < 255 )); then
    # It fails to boot user-namespaced containers whose root it maps with an
    # idmapped mount, failing with "Value too large for defined data type" as
    # it creates /var/log/journal.  Have it shift file ownership on disk
    # instead.
    mkdir -p /etc/systemd/nspawn

    for name in "${!pids[@]}"; do
        printf -- '[Files]\nPrivateUsersOwnership=chown\n' > "/etc/systemd/nspawn/${name}.nspawn"
    done

    # It gives guests running systemd 258 or later a legacy cgroup v1
    # hierarchy, on which they refuse to boot.
    mkdir -p /etc/systemd/system/systemd-nspawn@.service.d
    printf -- '[Service]\nEnvironment=SYSTEMD_NSPAWN_UNIFIED_HIERARCHY=1\n' \
        > /etc/systemd/system/systemd-nspawn@.service.d/unified-cgroup-hierarchy.conf
    systemctl daemon-reload
fi

machinectl --no-pager list-images

"${scripts_dir}/spawn-containers"
exec "${scripts_dir}/wait-is-system-running" "${!pids[@]}"
