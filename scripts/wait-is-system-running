#!/bin/sh

# Waits until systemd has finished booting, either on the host (no arguments)
# or in each of the named machines, and prints the resulting state.  Exits
# nonzero if a system ends up in a state other than "running" or "degraded",
# or is still booting after $WAIT_TIMEOUT seconds (default: 300).
#
# Usage: wait-is-system-running [MACHINE...]

set -eu

timeout="${WAIT_TIMEOUT:-300}"

wait_one() {
    deadline=$(( $(date +%s) + timeout ))

    while :; do
        # Prints e.g. "offline" (or nothing) until the machine's bus is up.
        state="$(systemctl ${1:+--machine="$1"} is-system-running 2>/dev/null)" || :

        case "$state" in
            running)
                break
                ;;
            degraded)
                systemctl ${1:+--machine="$1"} --no-pager --failed || :
                break
                ;;
            ''|offline|initializing|starting)
                if [ "$(date +%s)" -ge "$deadline" ]; then
                    echo "${1:-host}: timed out waiting for boot (state: ${state:-unknown})" 1>&2
                    return 1
                fi
                sleep 2
                ;;
            *)
                echo "${1:-host}: ${state}" 1>&2
                return 1
                ;;
        esac
    done

    echo "${1:-host}: ${state}"
}

if [ $# -eq 0 ]; then
    wait_one
    exit
fi

status=0

for machine in "$@"; do
    wait_one "$machine" || status=1
done

exit "$status"
