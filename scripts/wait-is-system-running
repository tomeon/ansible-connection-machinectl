#!/usr/bin/env bash

# Waits until systemd has finished booting, either on the host (no arguments)
# or in each of the named machines, and prints the resulting states.  Exits
# nonzero if a system ends up in a state other than "running" or "degraded",
# or if any is still booting after $WAIT_TIMEOUT seconds (default: 300); in
# that case, also prints what the system is still waiting for.
#
# Usage: wait-is-system-running [MACHINE...]

set -uo pipefail

deadline=$(( SECONDS + ${WAIT_TIMEOUT:-300} ))

if (( $# == 0 )); then
    set -- .host
fi

declare -A pending=()
for machine in "$@"; do
    pending[$machine]=1
done

status=0

while :; do
    for machine in "${!pending[@]}"; do
        # Prints e.g. "offline" (or nothing) until the machine's bus is up.
        state="$(systemctl --machine="$machine" is-system-running 2>/dev/null)"

        case "$state" in
            ''|offline|initializing|starting)
                continue
                ;;
            running)
                echo "${machine}: ${state}"
                ;;
            degraded)
                echo "${machine}: ${state}"
                systemctl --machine="$machine" --no-pager --failed
                ;;
            *)
                echo 1>&2 "${machine}: ${state}"
                status=1
                ;;
        esac

        unset "pending[$machine]"
    done

    if (( ${#pending[@]} == 0 )); then
        exit "$status"
    fi

    if (( SECONDS >= deadline )); then
        break
    fi

    sleep 2
done

for machine in "${!pending[@]}"; do
    echo 1>&2 "${machine}: timed out waiting for boot to finish"
    systemctl --machine="$machine" is-system-running 1>&2
    systemctl --machine="$machine" --no-pager list-jobs 1>&2
    if [[ "$machine" != .host ]]; then
        machinectl --no-pager status "$machine" 1>&2
    fi
done

exit 1
