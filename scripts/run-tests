#!/usr/bin/env bash

# Runs the integration tests with tox from the repository root; all arguments
# are passed on to `tox run`.  The tests target every running machine known to
# systemd-machined, and must be run as root because `machinectl shell` requires
# it.
#
# Example: sudo scripts/run-tests -e py314-ansible221

set -euo pipefail

cd "$(readlink -f "${BASH_SOURCE[0]%/*}/..")"

exec tox run "$@"
